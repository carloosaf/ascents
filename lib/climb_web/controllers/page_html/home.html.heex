<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div id="home-page" class="space-y-8">
    <section class="grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_24rem]">
      <div class="chalk-panel relative overflow-hidden rounded-lg border border-climb-line p-6 sm:p-8">
        <div class="absolute right-6 top-8 hidden rotate-3 gap-2 sm:grid">
          <span class="tape-label h-8 w-28 bg-grade-blue"></span>
          <span class="tape-label ml-12 h-8 w-20 bg-grade-pink"></span>
          <span class="tape-label h-8 w-32 bg-grade-yellow"></span>
        </div>
        <div class="relative z-10 flex flex-wrap items-center gap-3">
          <span class="tape-label bg-climb-tape px-3 py-1 text-xs font-black uppercase text-climb-tape-content">
            Spray wall social
          </span>
          <span class="text-sm font-semibold text-climb-muted">
            dark mode · bold grades · gym chatter
          </span>
        </div>
        <h1 class="climb-display relative z-10 mt-6 max-w-4xl text-5xl leading-none text-climb-chalk sm:text-7xl">
          Share sends like post-session chalk marks.
        </h1>
        <p class="relative z-10 mt-6 max-w-2xl text-base leading-7 text-climb-chalk-soft">
          Climb is a community feed for bouldering gyms. Members post session
          updates, mark ascents, comment on beta, and discover fresh routes
          from the gyms they care about.
        </p>
        <div class="relative z-10 mt-8 flex flex-wrap gap-3">
          <.button navigate={~p"/users/register"}>Join the community</.button>
          <.button navigate={~p"/users/log-in"} variant="secondary">Log in</.button>
        </div>
      </div>

      <.gym_header
        name="Bloc District"
        location="Madrid, Spain"
        members="1,284"
        active_routes="72"
      />
    </section>

    <section class="grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_24rem]">
      <div class="space-y-4">
        <.header>
          Live Feed Preview
          <:subtitle>Balanced media and text, built around the gym community loop.</:subtitle>
        </.header>

        <.feed_item
          id="home-feed-1"
          author="Mara Silva"
          gym="Bloc District"
          time="12 min ago"
          grade="V5"
          body="Sent Blue Circuit #18 after a lot of heel-hook negotiations. The last move is all commitment."
          comments={9}
          reaction_count={42}
        />

        <.feed_item
          id="home-feed-2"
          author="Joel Chen"
          gym="North Cave"
          time="38 min ago"
          body="Anyone around for a mellow slab session tonight? I want to trade beta on the new yellow set."
          comments={4}
          reaction_count={17}
        />
      </div>

      <aside class="space-y-4">
        <.header>
          Fresh Problems
          <:subtitle>Bold grades stay scannable before the title.</:subtitle>
        </.header>

        <.route_card
          id="home-route-1"
          title="Static Fever"
          gym="Bloc District"
          grade="V5"
          status="Active"
          meta="Cave wall · blue tape · reset yesterday"
        />

        <.route_card
          id="home-route-2"
          title="Tiny Feet Club"
          gym="North Cave"
          grade="V7"
          status="Project"
          meta="Slab wall · pink tape · technical finish"
        />
      </aside>
    </section>

    <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <.stat_block label="Sends this week" value="128" detail="+18% from last week" tone="lime" />
      <.stat_block label="Fresh problems" value="14" detail="Across 4 walls" tone="teal" />
      <.stat_block label="Most active grade" value="V4" detail="Community sweet spot" tone="clay" />
      <.stat_block label="New members" value="36" detail="Joined this month" tone="blue" />
    </section>
  </div>
</Layouts.app>
